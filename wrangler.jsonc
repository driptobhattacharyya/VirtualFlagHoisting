{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "virtual-flag-hoisting",
  "compatibility_date": "2026-11-01",
  // Copies the MediaPipe runtime and model into public/vendor/ before
  // `wrangler dev` and `wrangler deploy`.
  "build": {
    "command": "npm run build"
  },
  // Static assets only: there is no Worker script.
  "assets": {
    "directory": "./public"
  },
  // Custom domain: Cloudflare creates the DNS record and certificate. The
  // driptobhattacharyya.com zone must be on the account you deploy with.
  "routes": [
    {
      "pattern": "virtual-flag-hoisting.driptobhattacharyya.com",
      "custom_domain": true
    }
  ]
}
